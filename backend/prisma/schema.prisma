// Ruhama Clinic Management System - Complete Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// ============================================
// USERS & AUTHENTICATION
// ============================================

model User {
  id                      String          @id @default(uuid())
  email                   String          @unique
  passwordHash            String          @map("password_hash")
  fullName                String          @map("full_name")
  phone                   String?
  role                    UserRole
  department              String?
  employmentType          EmploymentType? @map("employment_type")
  isActive                Boolean         @default(false) @map("is_active")
  isApproved              Boolean         @default(false) @map("is_approved")
  emailVerified           Boolean         @default(false) @map("email_verified")
  emailVerificationToken  String?         @unique @map("email_verification_token")
  verificationEmailSentAt DateTime?       @map("verification_email_sent_at")
  emailVerifiedAt         DateTime?       @map("email_verified_at")
  profilePhoto            String?         @map("profile_photo")
  approvedById            String?         @map("approved_by_id")
  approvedAt              DateTime?       @map("approved_at")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  lastLogin               DateTime?       @map("last_login")

  // Relations
  sessions               UserSession[]
  approvedBy             User?                  @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedUsers          User[]                 @relation("UserApprovals")
  registeredPatients     Patient[]              @relation("RegisteredBy")
  registeredVisits       PatientVisit[]         @relation("RegisteredBy")
  assignedVisits         PatientVisit[]         @relation("AssignedDoctor")
  prescriptions          Prescription[]         @relation("PrescribedBy")
  dispensedPrescriptions Prescription[]         @relation("DispensedBy")
  labOrders              LabOrder[]             @relation("OrderedBy")
  verifiedLabOrders      LabOrder[]             @relation("VerifiedBy")
  ultrasoundOrders       UltrasoundOrder[]      @relation("OrderedBy")
  injectionOrders        InjectionOrder[]
  transactions           FinancialTransaction[]
  invoices               Invoice[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  patientLinkId          String?                @unique @map("patient_link_id")
  patientLink            Patient?               @relation("PatientPortalAccount", fields: [patientLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Appointment and schedule relations
  appointments     Appointment[]     @relation("DoctorAppointments")
  schedules        DoctorSchedule[]  @relation("DoctorSchedules")
  timeOffs         DoctorTimeOff[]   @relation("DoctorTimeOffs")
  patientAuditLogs PatientAuditLog[] @relation("PatientAuditLogs")

  // Super admin may use this linked doctor account for clinical work (one doctor per admin).
  clinicalPersonaUserId  String? @unique @map("clinical_persona_user_id")
  clinicalPersona        User?   @relation("AdminClinicalPersona", fields: [clinicalPersonaUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  clinicalPersonaOfAdmin User?   @relation("AdminClinicalPersona")

  // Staff reporting line (e.g. doctor supervised by super admin).
  supervisedByUserId String? @map("supervised_by_user_id")
  supervisedBy       User?   @relation("StaffSupervision", fields: [supervisedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supervisedStaff    User[]  @relation("StaffSupervision")

  // New module relations
  triageRecords          TriageRecord[]
  vitalSignRecords       VitalSigns[]
  nursingNotes           NursingNote[]
  injectionAdministered  InjectionAdministration[]
  emergencyCases         EmergencyCase[]
  sickLeaveCertificates  SickLeaveCertificate[]
  medicalCertificates    MedicalCertificate[]
  doctorEncounters       DoctorEncounter[]
  stockMovements         StockMovement[]
  stockAdjustments       StockAdjustment[]
  storeRequests          StoreRequest[]

  @@map("users")
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("user_sessions")
}

enum UserRole {
  SUPER_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PHARMACIST
  LAB_TECH
  FINANCE
  EMERGENCY
  INJECTION_ROOM
  PATIENT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

// ============================================
// PATIENT MANAGEMENT
// ============================================

model Patient {
  id                    String   @id @default(uuid())
  cardNumber            String   @unique @map("card_number")
  fullName              String   @map("full_name")
  sex                   Sex
  dateOfBirth           DateTime @map("date_of_birth")
  phone                 String?
  address               String?
  kebele                String?
  wereda                String?
  photoUrl              String?  @map("photo_url")
  medicalHistory        String?  @map("medical_history")
  allergies             String?
  bloodType             String?  @map("blood_type")
  emergencyContactName  String?  @map("emergency_contact_name")
  emergencyContactPhone String?  @map("emergency_contact_phone")

  // Enhanced medical history fields
  hasAllergies       Boolean @default(false) @map("has_allergies")
  allergyDetails     String? @map("allergy_details")
  hasDiabetes        Boolean @default(false) @map("has_diabetes")
  hasHypertension    Boolean @default(false) @map("has_hypertension")
  hasAsthma          Boolean @default(false) @map("has_asthma")
  hasHeartDisease    Boolean @default(false) @map("has_heart_disease")
  hasKidneyDisease   Boolean @default(false) @map("has_kidney_disease")
  hasEpilepsy        Boolean @default(false) @map("has_epilepsy")
  currentMedications String? @map("current_medications")
  familyHistory      String? @map("family_history")
  surgicalHistory    String? @map("surgical_history")
  socialHistory      String? @map("social_history")

  // Data integrity fields
  isIncomplete     Boolean   @default(false) @map("is_incomplete")
  incompleteReason String?   @map("incomplete_reason")
  archivedAt       DateTime? @map("archived_at")
  archivedBy       String?   @map("archived_by")
  archivedReason   String?   @map("archived_reason")

  registeredById   String   @map("registered_by_id")
  registeredBy     User     @relation("RegisteredBy", fields: [registeredById], references: [id], onUpdate: NoAction)
  registrationDate DateTime @default(now()) @map("registration_date")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  visits           PatientVisit[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  ultrasoundOrders UltrasoundOrder[]
  injectionOrders  InjectionOrder[]
  transactions     FinancialTransaction[]
  invoices         Invoice[]
  portalAccount    User?                  @relation("PatientPortalAccount")
  auditLogs        PatientAuditLog[]
  appointments     Appointment[]
  
  // New module relations
  triageRecords         TriageRecord[]
  vitalSigns            VitalSigns[]
  nursingNotes          NursingNote[]
  emergencyCases        EmergencyCase[]
  doctorEncounters      DoctorEncounter[]
  sickLeaveCertificates SickLeaveCertificate[]
  medicalCertificates   MedicalCertificate[]

  @@map("patients")
}

model PatientVisit {
  id               String      @id @default(uuid())
  patientId        String      @map("patient_id")
  patient          Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  visitNumber      Int         @map("visit_number")
  visitType        VisitType   @map("visit_type")
  visitDate        DateTime    @default(now()) @map("visit_date")
  cardFee          Decimal     @default(30.00) @map("card_fee") @db.Decimal(10, 2)
  serviceType      ServiceType @map("service_type")
  assignedDoctorId String?     @map("assigned_doctor_id")
  assignedDoctor   User?       @relation("AssignedDoctor", fields: [assignedDoctorId], references: [id], onUpdate: NoAction)
  status           VisitStatus @default(REGISTERED)

  // Triage and appointment fields
  triageLevel   TriageLevel? @map("triage_level")
  isWalkIn      Boolean      @default(true) @map("is_walk_in")
  appointmentId String?      @unique @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onUpdate: NoAction)
  arrivedAt     DateTime?    @map("arrived_at")
  queuePosition Int?         @map("queue_position")

  registeredById String   @map("registered_by_id")
  registeredBy   User     @relation("RegisteredBy", fields: [registeredById], references: [id], onUpdate: NoAction)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  ultrasoundOrders UltrasoundOrder[]
  injectionOrders  InjectionOrder[]
  transactions     FinancialTransaction[]
  invoices         Invoice[]
  
  // New module relations
  triageRecords         TriageRecord[]
  vitalSigns            VitalSigns[]
  nursingNotes          NursingNote[]
  doctorEncounters      DoctorEncounter[]
  sickLeaveCertificates SickLeaveCertificate[]
  medicalCertificates   MedicalCertificate[]
  emergencyCase         EmergencyCase?

  @@map("patient_visits")
}

enum Sex {
  MALE
  FEMALE
}

enum VisitType {
  NEW
  REPEAT
  FOLLOW_UP
}

enum ServiceType {
  OPD
  ULTRASOUND
  EMERGENCY
  INJECTION
}

enum VisitStatus {
  REGISTERED
  IN_QUEUE
  IN_CONSULTATION
  COMPLETED
}

enum TriageLevel {
  CRITICAL
  URGENT
  SEMI_URGENT
  NON_URGENT
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// ============================================
// APPOINTMENTS & SCHEDULING
// ============================================

model Appointment {
  id                String            @id @default(uuid())
  appointmentNumber String            @unique @map("appointment_number")
  patientId         String            @map("patient_id")
  patient           Patient           @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  doctorId          String            @map("doctor_id")
  doctor            User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onUpdate: NoAction)
  appointmentDate   DateTime          @map("appointment_date")
  startTime         DateTime          @map("start_time")
  endTime           DateTime          @map("end_time")
  serviceType       ServiceType       @map("service_type")
  reason            String?
  notes             String?
  status            AppointmentStatus @default(SCHEDULED)

  // Check-in and completion
  checkedInAt DateTime? @map("checked_in_at")
  completedAt DateTime? @map("completed_at")

  // Cancellation
  cancelledAt        DateTime? @map("cancelled_at")
  cancelledBy        String?   @map("cancelled_by")
  cancellationReason String?   @map("cancellation_reason")

  // Rescheduling
  rescheduledFrom String? @map("rescheduled_from")
  rescheduledTo   String? @map("rescheduled_to")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  visit PatientVisit?

  @@index([doctorId, appointmentDate])
  @@index([patientId])
  @@index([status])
  @@map("appointments")
}

model DoctorSchedule {
  id             String   @id @default(uuid())
  doctorId       String   @map("doctor_id")
  doctor         User     @relation("DoctorSchedules", fields: [doctorId], references: [id], onUpdate: NoAction)
  dayOfWeek      Int      @map("day_of_week") // 0=Sunday, 6=Saturday
  startTime      String   @map("start_time") // HH:mm format
  endTime        String   @map("end_time") // HH:mm format
  breakStartTime String?  @map("break_start_time")
  breakEndTime   String?  @map("break_end_time")
  slotDuration   Int      @default(30) @map("slot_duration") // minutes
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model DoctorTimeOff {
  id        String   @id @default(uuid())
  doctorId  String   @map("doctor_id")
  doctor    User     @relation("DoctorTimeOffs", fields: [doctorId], references: [id], onUpdate: NoAction)
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  reason    String?
  isAllDay  Boolean  @default(true) @map("is_all_day")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([doctorId, startDate, endDate])
  @@map("doctor_time_offs")
}

model PatientAuditLog {
  id           String   @id @default(uuid())
  patientId    String   @map("patient_id")
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fieldName    String   @map("field_name")
  oldValue     String?  @map("old_value")
  newValue     String?  @map("new_value")
  changeReason String?  @map("change_reason")
  changedById  String   @map("changed_by_id")
  changedBy    User     @relation("PatientAuditLogs", fields: [changedById], references: [id], onUpdate: NoAction)
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([patientId, createdAt])
  @@map("patient_audit_logs")
}

// ============================================
// PRESCRIPTIONS
// ============================================

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique @map("prescription_number")
  visitId            String             @map("visit_id")
  visit              PatientVisit       @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId          String             @map("patient_id")
  patient            Patient            @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  doctorId           String             @map("doctor_id")
  doctor             User               @relation("PrescribedBy", fields: [doctorId], references: [id], onUpdate: NoAction)
  status             PrescriptionStatus @default(PENDING)
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  dispensedAt        DateTime?          @map("dispensed_at")
  dispensedById      String?            @map("dispensed_by_id")
  dispensedBy        User?              @relation("DispensedBy", fields: [dispensedById], references: [id], onUpdate: NoAction)

  // Relations
  items PrescriptionItem[]

  @@map("prescriptions")
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String       @map("prescription_id")
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drugId         String?      @map("drug_id")
  drug           Drug?        @relation(fields: [drugId], references: [id])
  drugName       String       @map("drug_name")
  dosage         String
  frequency      String
  duration       String
  quantity       Int
  instructions   String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("prescription_items")
}

model Drug {
  id                String   @id @default(uuid())
  drugName          String   @map("drug_name")
  genericName       String?  @map("generic_name")
  brandName         String?  @map("brand_name")
  drugCategory      String?  @map("drug_category")
  dosageForm        String?  @map("dosage_form")
  strength          String?
  unit              String?
  description       String?
  sideEffects       String?  @map("side_effects")
  contraindications String?
  storageConditions String?  @map("storage_conditions")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  prescriptionItems PrescriptionItem[]
  stockItems        PharmacyStock[]

  @@map("drugs")
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  CANCELLED
}

// ============================================
// LABORATORY
// ============================================

model LabTest {
  id             String   @id @default(uuid())
  testCode       String   @unique @map("test_code")
  testName       String   @map("test_name")
  testCategory   String?  @map("test_category")
  description    String?
  sampleType     String?  @map("sample_type")
  normalRange    String?  @map("normal_range")
  unit           String?
  price          Decimal? @db.Decimal(10, 2)
  turnaroundTime Int?     @map("turnaround_time")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  orderItems LabOrderItem[]

  @@map("lab_tests")
}

model LabOrder {
  id            String        @id @default(uuid())
  orderNumber   String        @unique @map("order_number")
  visitId       String?       @map("visit_id")
  visit         PatientVisit? @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId     String        @map("patient_id")
  patient       Patient       @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  orderedById   String        @map("ordered_by_id")
  orderedBy     User          @relation("OrderedBy", fields: [orderedById], references: [id], onUpdate: NoAction)
  priority      LabPriority   @default(ROUTINE)
  clinicalNotes String?       @map("clinical_notes")
  status        LabStatus     @default(PENDING)
  orderedAt     DateTime      @default(now()) @map("ordered_at")
  completedAt   DateTime?     @map("completed_at")
  verifiedAt    DateTime?     @map("verified_at")
  verifiedById  String?       @map("verified_by_id")
  verifiedBy    User?         @relation("VerifiedBy", fields: [verifiedById], references: [id], onUpdate: NoAction)

  // Relations
  items LabOrderItem[]

  @@map("lab_orders")
}

model LabOrderItem {
  id         String    @id @default(uuid())
  orderId    String    @map("order_id")
  order      LabOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  testId     String    @map("test_id")
  test       LabTest   @relation(fields: [testId], references: [id])
  testName   String    @map("test_name")
  result     String?
  isAbnormal Boolean?  @map("is_abnormal")
  notes      String?
  status     LabStatus @default(PENDING)
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("lab_order_items")
}

enum LabPriority {
  STAT
  URGENT
  ROUTINE
}

enum LabStatus {
  PENDING
  SAMPLE_COLLECTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

// ============================================
// PHARMACY
// ============================================

model PharmacyStock {
  id              String      @id @default(uuid())
  drugId          String      @map("drug_id")
  drug            Drug        @relation(fields: [drugId], references: [id])
  batchNumber     String      @map("batch_number")
  quantityInStock Int         @default(0) @map("quantity_in_stock")
  unitPrice       Decimal     @map("unit_price") @db.Decimal(10, 2)
  sellingPrice    Decimal     @map("selling_price") @db.Decimal(10, 2)
  expiryDate      DateTime    @map("expiry_date")
  manufacturer    String?
  supplier        String?
  receivedDate    DateTime?   @map("received_date")
  reorderLevel    Int         @default(10) @map("reorder_level")
  status          StockStatus @default(AVAILABLE)
  location        String?
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("pharmacy_stock")
}

enum StockStatus {
  AVAILABLE
  LOW
  OUT_OF_STOCK
  EXPIRED
}

// ============================================
// ULTRASOUND
// ============================================

model UltrasoundOrder {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique @map("order_number")
  visitId            String           @map("visit_id")
  visit              PatientVisit     @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId          String           @map("patient_id")
  patient            Patient          @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  ultrasoundType     String           @map("ultrasound_type")
  isFollowUp         Boolean          @default(false) @map("is_follow_up")
  price              Decimal          @db.Decimal(10, 2)
  clinicalIndication String?          @map("clinical_indication")
  orderedById        String           @map("ordered_by_id")
  orderedBy          User             @relation("OrderedBy", fields: [orderedById], references: [id], onUpdate: NoAction)
  status             UltrasoundStatus @default(SCHEDULED)
  scheduledDate      DateTime?        @map("scheduled_date")
  completedAt        DateTime?        @map("completed_at")
  createdAt          DateTime         @default(now()) @map("created_at")

  @@map("ultrasound_orders")
}

enum UltrasoundStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  REPORTED
}

// ============================================
// INJECTIONS
// ============================================

model InjectionOrder {
  id             String          @id @default(uuid())
  orderNumber    String          @unique @map("order_number")
  visitId        String          @map("visit_id")
  visit          PatientVisit    @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId      String          @map("patient_id")
  patient        Patient         @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  medicationName String          @map("medication_name")
  dosage         String
  route          String
  frequency      String?
  duration       String?
  orderedById    String          @map("ordered_by_id")
  orderedBy      User            @relation(fields: [orderedById], references: [id])
  status         InjectionStatus @default(PENDING)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  
  // Relations
  administrations InjectionAdministration[]

  @@map("injection_orders")
}

enum InjectionStatus {
  PENDING
  ADMINISTERED
  CANCELLED
}

// ============================================
// FINANCE
// ============================================

model FinancialTransaction {
  id                String        @id @default(uuid())
  transactionNumber String        @unique @map("transaction_number")
  patientId         String?       @map("patient_id")
  patient           Patient?      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  visitId           String?       @map("visit_id")
  visit             PatientVisit? @relation(fields: [visitId], references: [id], onUpdate: NoAction)
  transactionType   String        @map("transaction_type")
  amount            Decimal       @db.Decimal(10, 2)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  referenceNumber   String?       @map("reference_number")
  description       String?
  collectedById     String?       @map("collected_by_id")
  collectedBy       User?         @relation(fields: [collectedById], references: [id], onUpdate: NoAction)
  transactionDate   DateTime      @default(now()) @map("transaction_date")
  createdAt         DateTime      @default(now()) @map("created_at")

  @@map("financial_transactions")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  patientId     String        @map("patient_id")
  patient       Patient       @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  visitId       String?       @map("visit_id")
  visit         PatientVisit? @relation(fields: [visitId], references: [id], onUpdate: NoAction)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(10, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(10, 2)
  status        InvoiceStatus @default(UNPAID)
  issuedById    String        @map("issued_by_id")
  issuedBy      User          @relation(fields: [issuedById], references: [id], onUpdate: NoAction)
  issuedAt      DateTime      @default(now()) @map("issued_at")
  paidAt        DateTime?     @map("paid_at")

  // Relations
  items InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String   @map("invoice_id")
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  itemType        String   @map("item_type")
  itemDescription String   @map("item_description")
  quantity        Int      @default(1)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice      Decimal  @map("total_price") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  CHAPA
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// ============================================
// SYSTEM
// ============================================

model Notification {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onUpdate: NoAction)
  notificationType String    @map("notification_type")
  title            String
  message          String
  isRead           Boolean   @default(false) @map("is_read")
  relatedId        String?   @map("related_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  readAt           DateTime? @map("read_at")

  @@map("notifications")
}

// ============================================
// NURSE MODULE - TRIAGE & VITAL SIGNS
// ============================================

model TriageRecord {
  id              String       @id @default(uuid())
  visitId         String       @map("visit_id")
  visit           PatientVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId       String       @map("patient_id")
  patient         Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  triageLevel     TriageLevel  @map("triage_level")
  chiefComplaint  String       @map("chief_complaint")
  
  // Vital Signs at Triage
  bloodPressure   String?      @map("blood_pressure")
  heartRate       Int?         @map("heart_rate")
  respiratoryRate Int?         @map("respiratory_rate")
  temperature     Decimal?     @db.Decimal(4, 1)
  oxygenSaturation Int?        @map("oxygen_saturation")
  weight          Decimal?     @db.Decimal(5, 2)
  height          Decimal?     @db.Decimal(5, 2)
  bmi             Decimal?     @db.Decimal(4, 2)
  painScore       Int?         @map("pain_score") // 0-10
  
  // Additional Assessment
  isPregnant      Boolean?     @map("is_pregnant")
  lmp             DateTime?    @map("lmp") // Last Menstrual Period
  allergies       String?
  chronicIllnesses String?     @map("chronic_illnesses")
  
  // Routing
  routedTo        ServiceType  @map("routed_to")
  alertSent       Boolean      @default(false) @map("alert_sent")
  
  triageById      String       @map("triage_by_id")
  triageBy        User         @relation(fields: [triageById], references: [id], onUpdate: NoAction)
  triageAt        DateTime     @default(now()) @map("triage_at")
  
  @@map("triage_records")
}

model VitalSigns {
  id               String       @id @default(uuid())
  visitId          String       @map("visit_id")
  visit            PatientVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId        String       @map("patient_id")
  patient          Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  
  bloodPressure    String?      @map("blood_pressure")
  heartRate        Int?         @map("heart_rate")
  respiratoryRate  Int?         @map("respiratory_rate")
  temperature      Decimal?     @db.Decimal(4, 1)
  oxygenSaturation Int?         @map("oxygen_saturation")
  weight           Decimal?     @db.Decimal(5, 2)
  height           Decimal?     @db.Decimal(5, 2)
  bmi              Decimal?     @db.Decimal(4, 2)
  painScore        Int?         @map("pain_score")
  
  notes            String?
  isAbnormal       Boolean      @default(false) @map("is_abnormal")
  
  recordedById     String       @map("recorded_by_id")
  recordedBy       User         @relation(fields: [recordedById], references: [id], onUpdate: NoAction)
  recordedAt       DateTime     @default(now()) @map("recorded_at")
  
  @@index([visitId, recordedAt])
  @@map("vital_signs")
}

model NursingNote {
  id          String       @id @default(uuid())
  visitId     String       @map("visit_id")
  visit       PatientVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId   String       @map("patient_id")
  patient     Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  
  // SOAP-N Format
  subjective  String?      // Patient statements
  objective   String?      // Measurable observations
  assessment  String?      // Nursing assessment
  plan        String?      // Interventions
  
  noteType    String?      @map("note_type") // wound_care, fever, dehydration, pain, etc.
  attachments String? @db.Text     // File paths for wound photos, reports
  
  isLocked    Boolean      @default(false) @map("is_locked")
  lockedAt    DateTime?    @map("locked_at")
  
  createdById String       @map("created_by_id")
  createdBy   User         @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  
  @@map("nursing_notes")
}

// ============================================
// INJECTION ROOM - ENHANCED
// ============================================

model InjectionAdministration {
  id              String          @id @default(uuid())
  orderId         String          @map("order_id")
  order           InjectionOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  
  // 5 Rights Verification
  patientVerified Boolean         @default(false) @map("patient_verified")
  medicationVerified Boolean      @default(false) @map("medication_verified")
  doseVerified    Boolean         @default(false) @map("dose_verified")
  routeVerified   Boolean         @default(false) @map("route_verified")
  timeVerified    Boolean         @default(false) @map("time_verified")
  
  // Administration Details
  route           InjectionRoute
  site            InjectionSite
  lotNumber       String          @map("lot_number")
  expiryDate      DateTime        @map("expiry_date")
  administeredAt  DateTime        @default(now()) @map("administered_at")
  
  // Adverse Events
  hasAdverseEvent Boolean         @default(false) @map("has_adverse_event")
  adverseEventType String?        @map("adverse_event_type")
  adverseEventSeverity String?    @map("adverse_event_severity")
  adverseEventNotes String?       @map("adverse_event_notes")
  
  // Consumables Used
  syringeUsed     Boolean         @default(true) @map("syringe_used")
  needleUsed      Boolean         @default(true) @map("needle_used")
  alcoholSwabUsed Boolean         @default(true) @map("alcohol_swab_used")
  glovesUsed      Boolean         @default(true) @map("gloves_used")
  
  notes           String?
  
  administeredById String         @map("administered_by_id")
  administeredBy   User           @relation(fields: [administeredById], references: [id], onUpdate: NoAction)
  
  @@map("injection_administrations")
}

enum InjectionRoute {
  IV    // Intravenous
  IM    // Intramuscular
  SC    // Subcutaneous
  ID    // Intradermal
  PO    // Per Oral
}

enum InjectionSite {
  LEFT_DELTOID
  RIGHT_DELTOID
  LEFT_DORSOGLUTEAL
  RIGHT_DORSOGLUTEAL
  LEFT_VASTUS_LATERALIS
  RIGHT_VASTUS_LATERALIS
  LEFT_VENTROGLUTEAL
  RIGHT_VENTROGLUTEAL
  ABDOMEN
  LEFT_THIGH
  RIGHT_THIGH
}

// ============================================
// EMERGENCY MODULE
// ============================================

model EmergencyCase {
  id                    String              @id @default(uuid())
  caseNumber            String              @unique @map("case_number")
  
  // Minimal Registration
  patientId             String?             @map("patient_id")
  patient               Patient?            @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  temporaryName         String?             @map("temporary_name")
  approximateAge        Int?                @map("approximate_age")
  sex                   Sex?
  phone                 String?
  
  // Triage
  triageLevel           TriageLevel         @map("triage_level")
  chiefComplaint        String              @map("chief_complaint")
  arrivalMode           EmergencyArrivalMode @map("arrival_mode")
  
  // Vital Signs
  bloodPressure         String?             @map("blood_pressure")
  heartRate             Int?                @map("heart_rate")
  respiratoryRate       Int?                @map("respiratory_rate")
  temperature           Decimal?            @db.Decimal(4, 1)
  oxygenSaturation      Int?                @map("oxygen_saturation")
  glasgowComaScale      Int?                @map("glasgow_coma_scale")
  
  // Treatment
  treatmentNotes        String?             @map("treatment_notes")
  proceduresPerformed String? @db.Text            @map("procedures_performed")
  medicationsGiven String? @db.Text            @map("medications_given")
  
  // Disposition
  disposition           EmergencyDisposition?
  dispositionNotes      String?             @map("disposition_notes")
  referredTo            String?             @map("referred_to")
  
  // Status
  status                EmergencyStatus     @default(ACTIVE)
  isConverted           Boolean             @default(false) @map("is_converted")
  convertedVisitId      String?             @unique @map("converted_visit_id")
  convertedVisit        PatientVisit?       @relation(fields: [convertedVisitId], references: [id], onUpdate: NoAction)
  
  // Timestamps
  arrivedAt             DateTime            @default(now()) @map("arrived_at")
  triageCompletedAt     DateTime?           @map("triage_completed_at")
  treatmentStartedAt    DateTime?           @map("treatment_started_at")
  stabilizedAt          DateTime?           @map("stabilized_at")
  dispositionAt         DateTime?           @map("disposition_at")
  
  registeredById        String              @map("registered_by_id")
  registeredBy          User                @relation(fields: [registeredById], references: [id], onUpdate: NoAction)
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  
  @@map("emergency_cases")
}

enum EmergencyArrivalMode {
  WALK_IN
  AMBULANCE
  POLICE
  CARRIED
  WHEELCHAIR
}

enum EmergencyDisposition {
  DISCHARGED
  ADMITTED
  REFERRED
  TRANSFERRED
  LEFT_AMA  // Against Medical Advice
  DECEASED
}

enum EmergencyStatus {
  ACTIVE
  STABILIZED
  COMPLETED
}

// ============================================
// DOCTOR MODULE - ENHANCED ENCOUNTERS
// ============================================

model DoctorEncounter {
  id                String       @id @default(uuid())
  visitId           String       @map("visit_id")
  visit             PatientVisit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  patientId         String       @map("patient_id")
  patient           Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  doctorId          String       @map("doctor_id")
  doctor            User         @relation(fields: [doctorId], references: [id], onUpdate: NoAction)
  
  // SOAP Notes
  subjective        String?      // Chief complaint, history
  objective         String?      // Physical examination findings
  assessment        String?      // Diagnosis
  plan              String?      // Treatment plan
  
  // Diagnosis
  primaryDiagnosis  String?      @map("primary_diagnosis")
  icdCode           String?      @map("icd_code")
  secondaryDiagnoses String? @db.Text    @map("secondary_diagnoses")
  
  // Clinical Notes
  historyOfPresentIllness String? @map("history_of_present_illness")
  physicalExamination     String? @map("physical_examination")
  differentialDiagnosis   String? @map("differential_diagnosis")
  treatmentPlan           String? @map("treatment_plan")
  
  // Follow-up
  followUpRequired  Boolean      @default(false) @map("follow_up_required")
  followUpDate      DateTime?    @map("follow_up_date")
  followUpNotes     String?      @map("follow_up_notes")
  
  // Referral
  isReferral        Boolean      @default(false) @map("is_referral")
  referralTo        String?      @map("referral_to")
  referralReason    String?      @map("referral_reason")
  referralNotes     String?      @map("referral_notes")
  
  // Status
  status            EncounterStatus @default(IN_PROGRESS)
  startedAt         DateTime     @default(now()) @map("started_at")
  completedAt       DateTime?    @map("completed_at")
  
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  
  @@map("doctor_encounters")
}

enum EncounterStatus {
  IN_PROGRESS
  COMPLETED
  FOLLOW_UP_NEEDED
}

// ============================================
// MEDICAL CERTIFICATES
// ============================================

model SickLeaveCertificate {
  id                  String       @id @default(uuid())
  certificateNumber   String       @unique @map("certificate_number")
  patientId           String       @map("patient_id")
  patient             Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  visitId             String?      @map("visit_id")
  visit               PatientVisit? @relation(fields: [visitId], references: [id], onUpdate: NoAction)
  
  examinationDate     DateTime     @map("examination_date")
  diagnosis           String
  sickLeaveDays       Int          @map("sick_leave_days")
  startDate           DateTime     @map("start_date")
  endDate             DateTime     @map("end_date")
  additionalNotes     String?      @map("additional_notes")
  
  issuedById          String       @map("issued_by_id")
  issuedBy            User         @relation(fields: [issuedById], references: [id], onUpdate: NoAction)
  issuedAt            DateTime     @default(now()) @map("issued_at")
  
  // PDF Generation
  pdfPath             String?      @map("pdf_path")
  pdfGeneratedAt      DateTime?    @map("pdf_generated_at")
  
  @@map("sick_leave_certificates")
}

model MedicalCertificate {
  id                String       @id @default(uuid())
  certificateNumber String       @unique @map("certificate_number")
  patientId         String       @map("patient_id")
  patient           Patient      @relation(fields: [patientId], references: [id], onUpdate: NoAction)
  visitId           String?      @map("visit_id")
  visit             PatientVisit? @relation(fields: [visitId], references: [id], onUpdate: NoAction)
  
  certificateType   MedicalCertificateType @map("certificate_type")
  purpose           String       // Employment, Migration, etc.
  
  // Personal Data
  nationality       String?
  passportNumber    String?      @map("passport_number")
  maritalStatus     String?      @map("marital_status")
  jobTitle          String?      @map("job_title")
  
  // Vital Data
  bloodPressure     String?      @map("blood_pressure")
  weight            Decimal?     @db.Decimal(5, 2)
  height            Decimal?     @db.Decimal(5, 2)
  ecgResult         String?      @map("ecg_result")
  pulseRegularity   String?      @map("pulse_regularity")
  visionLeft        String?      @map("vision_left")
  visionRight       String?      @map("vision_right")
  visionStatus      String?      @map("vision_status")
  colorVision       String?      @map("color_vision")
  
  // Clinical Examination (JSON for flexibility)
  generalExam       Json?        @map("general_exam")
  entExam           Json?        @map("ent_exam")
  cardiovascularExam Json?       @map("cardiovascular_exam")
  respiratoryExam   Json?        @map("respiratory_exam")
  abdomenExam       Json?        @map("abdomen_exam")
  musculoskeletalExam Json?      @map("musculoskeletal_exam")
  chestXray         Json?        @map("chest_xray")
  
  // Lab Investigations (JSON for flexibility)
  stoolExam         Json?        @map("stool_exam")
  urineExam         Json?        @map("urine_exam")
  serologyTests     Json?        @map("serology_tests")
  
  // Final Result
  finalResult       MedicalCertificateResult @map("final_result")
  remarks           String?
  
  // Signatures
  patientSignature  String?      @map("patient_signature")
  patientSignedAt   DateTime?    @map("patient_signed_at")
  doctorSignature   String?      @map("doctor_signature")
  
  issuedById        String       @map("issued_by_id")
  issuedBy          User         @relation(fields: [issuedById], references: [id], onUpdate: NoAction)
  issuedAt          DateTime     @default(now()) @map("issued_at")
  
  // PDF Generation
  pdfPath           String?      @map("pdf_path")
  pdfGeneratedAt    DateTime?    @map("pdf_generated_at")
  
  @@map("medical_certificates")
}

enum MedicalCertificateType {
  GENERAL
  EMPLOYMENT
  MIGRATION
  SCHOOL
  INSURANCE
}

enum MedicalCertificateResult {
  FIT
  UNFIT
  FIT_WITH_RESTRICTIONS
}

// ============================================
// INVENTORY & STORE MODULE
// ============================================

model Supplier {
  id             String   @id @default(uuid())
  name           String
  tin            String?  @unique
  phone          String?
  address        String?
  contactPerson  String?  @map("contact_person")
  email          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  // Relations
  purchaseInvoices PurchaseInvoice[]
  batches          InventoryBatch[]
  
  @@map("suppliers")
}

model InventoryItem {
  id            String   @id @default(uuid())
  name          String
  genericName   String?  @map("generic_name")
  strength      String?
  form          String?  // Tablet, Capsule, Syrup, etc.
  category      String?
  unit          String?  // Box, Strip, Bottle, etc.
  reorderLevel  Int      @default(10) @map("reorder_level")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relations
  batches         InventoryBatch[]
  movements       StockMovement[]
  adjustments     StockAdjustment[]
  requestItems    StoreRequestItem[]
  
  @@map("inventory_items")
}

model InventoryLocation {
  id        String   @id @default(uuid())
  name      String   @unique
  type      LocationType
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  
  // Relations
  stockFrom StockMovement[] @relation("FromLocation")
  stockTo   StockMovement[] @relation("ToLocation")
  stock     InventoryStock[]
  adjustments StockAdjustment[]
  
  @@map("inventory_locations")
}

enum LocationType {
  MAIN_STORE
  PHARMACY
  INJECTION_ROOM
  LAB
}

model InventoryBatch {
  id            String          @id @default(uuid())
  itemId        String          @map("item_id")
  item          InventoryItem   @relation(fields: [itemId], references: [id])
  supplierId    String?         @map("supplier_id")
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  batchNumber   String          @map("batch_number")
  expiryDate    DateTime        @map("expiry_date")
  unitCost      Decimal         @map("unit_cost") @db.Decimal(10, 2)
  invoiceId     String?         @map("invoice_id")
  invoice       PurchaseInvoice? @relation(fields: [invoiceId], references: [id])
  createdAt     DateTime        @default(now()) @map("created_at")
  
  // Relations
  stock         InventoryStock[]
  movements     StockMovement[]
  
  @@unique([itemId, batchNumber])
  @@map("inventory_batches")
}

model InventoryStock {
  id              String            @id @default(uuid())
  batchId         String            @map("batch_id")
  batch           InventoryBatch    @relation(fields: [batchId], references: [id])
  locationId      String            @map("location_id")
  location        InventoryLocation @relation(fields: [locationId], references: [id])
  quantityOnHand  Int               @default(0) @map("quantity_on_hand")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  
  @@unique([batchId, locationId])
  @@map("inventory_stock")
}

model StockMovement {
  id              String            @id @default(uuid())
  itemId          String            @map("item_id")
  item            InventoryItem     @relation(fields: [itemId], references: [id])
  batchId         String?           @map("batch_id")
  batch           InventoryBatch?   @relation(fields: [batchId], references: [id])
  fromLocationId  String?           @map("from_location_id")
  fromLocation    InventoryLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String?           @map("to_location_id")
  toLocation      InventoryLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
  quantity        Int
  movementType    MovementType      @map("movement_type")
  reason          String?
  referenceType   String?           @map("reference_type") // PurchaseInvoice, Prescription, LabOrder, etc.
  referenceId     String?           @map("reference_id")
  createdById     String            @map("created_by_id")
  createdBy       User              @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  createdAt       DateTime          @default(now()) @map("created_at")
  
  @@index([itemId, createdAt])
  @@map("stock_movements")
}

enum MovementType {
  PURCHASE_IN
  TRANSFER_OUT
  TRANSFER_IN
  DISPENSE_OUT
  ADJUSTMENT_PLUS
  ADJUSTMENT_MINUS
  EXPIRED_OUT
  DAMAGED_OUT
}

model StockAdjustment {
  id          String            @id @default(uuid())
  itemId      String            @map("item_id")
  item        InventoryItem     @relation(fields: [itemId], references: [id])
  batchId     String?           @map("batch_id")
  locationId  String            @map("location_id")
  location    InventoryLocation @relation(fields: [locationId], references: [id])
  qtyChange   Int               @map("qty_change")
  reason      String
  status      AdjustmentStatus  @default(PENDING)
  createdById String            @map("created_by_id")
  createdBy   User              @relation(fields: [createdById], references: [id], onUpdate: NoAction)
  approvedById String?          @map("approved_by_id")
  approvedAt  DateTime?         @map("approved_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  
  @@map("stock_adjustments")
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
}

model PurchaseInvoice {
  id              String          @id @default(uuid())
  invoiceNumber   String          @unique @map("invoice_number")
  supplierId      String          @map("supplier_id")
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  invoiceDate     DateTime        @map("invoice_date")
  invoicePhotoPath String?        @map("invoice_photo_path")
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  status          InvoiceStatus   @default(UNPAID)
  createdById     String          @map("created_by_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  
  // Relations
  batches         InventoryBatch[]
  
  @@map("purchase_invoices")
}


// ============================================
// STORE REQUEST (Pharmacy → Store)
// ============================================

model StoreRequest {
  id              String              @id @default(uuid())
  requestNumber   String              @unique @map("request_number")
  requestedById   String              @map("requested_by_id")
  requestedBy     User                @relation(fields: [requestedById], references: [id], onUpdate: NoAction)
  fromLocationId  String              @map("from_location_id") // MAIN_STORE
  toLocationId    String              @map("to_location_id") // PHARMACY, INJECTION_ROOM
  status          StoreRequestStatus  @default(PENDING)
  requestedAt     DateTime            @default(now()) @map("requested_at")
  approvedById    String?             @map("approved_by_id")
  approvedAt      DateTime?           @map("approved_at")
  rejectedReason  String?             @map("rejected_reason")
  notes           String?
  
  // Relations
  items           StoreRequestItem[]
  
  @@map("store_requests")
}

model StoreRequestItem {
  id              String        @id @default(uuid())
  requestId       String        @map("request_id")
  request         StoreRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  itemId          String        @map("item_id")
  item            InventoryItem @relation(fields: [itemId], references: [id])
  requestedQty    Int           @map("requested_qty")
  approvedQty     Int?          @map("approved_qty")
  batchId         String?       @map("batch_id")
  notes           String?
  
  @@map("store_request_items")
}

enum StoreRequestStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  FULFILLED
}

// ============================================
// AUDIT LOG & MONITORING
// ============================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  user         User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)
  action       String
  resource     String
  resourceId   String?  @map("resource_id")
  oldValues    String?  @map("old_values") // JSON string
  newValues    String?  @map("new_values") // JSON string
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  sessionId    String?  @map("session_id")
  success      Boolean  @default(true)
  errorMessage String?  @map("error_message")
  metadata     String?  // JSON string
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
  @@map("audit_logs")
}


// ============================================
// CONTACT US MESSAGES
// ============================================

model ContactMessage {
  id          String                @id @default(uuid())
  fullName    String                @map("full_name")
  email       String
  phone       String?
  subject     String?
  message     String
  status      ContactMessageStatus  @default(PENDING)
  response    String?
  respondedBy String?               @map("responded_by")
  respondedAt DateTime?             @map("responded_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@map("contact_messages")
}

enum ContactMessageStatus {
  PENDING
  IN_PROGRESS
  RESPONDED
  CLOSED
}
