# Local Development Environment
# XAMPP MySQL credentials: root / admin
DATABASE_URL="mysql://root:admin@localhost:3306/ruhama_clinic"

PORT=5000
NODE_ENV=development

JWT_SECRET=ruhama-clinic-dev-secret-change-for-production
JWT_EXPIRES_IN=24h

# API CORS: browser origins allowed to call this server
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:5000

# Frontend URLs
BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Optional for local dev)
EMAIL_HOST=bellini.hostns.io
EMAIL_PORT=465
EMAIL_USER=info@ruhamametekiyamediumclinic.net
EMAIL_PASSWORD="Holyghost321@#$%"
ADMIN_EMAIL=info@ruhamametekiyamediumclinic.net
EMAIL_FROM_NAME=Ruhama Metekiya Medium Clinic
